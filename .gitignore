# --- build output ---
/bin/
/dist/
/build/
# Root-level binaries from `go build ./cmd/...`. Anchored with a leading slash so
# they do NOT match the source package dir cmd/chomosyncer-go/.
/chomosyncer-go
/chomosyncer-go.exe
/loadgen
/loadgen.exe
*.test
*.out
# Windows build artifacts (never a source dir).
*.exe

# --- Go tooling ---
/vendor/
go.work
go.work.sum

# --- profiling / coverage ---
*.prof
*.pprof
*.cpu
*.mem
coverage.txt
coverage.html
cover.out
*.cover

# --- local runtime / secrets ---
.env
.env.*
*.env
!.env.example
!*.env.example
!deploy/*.env.example
config.yaml
*.local.yml
*.local.yaml

# --- docker / data volumes (if bind-mounted) ---
/deploy/data/
**/data/
**/_data/

# --- editor / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- scratch ---
/tmp/
/scratch/
/scratchpad/
