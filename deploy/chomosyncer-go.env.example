# REFERENCE ONLY — the docker-compose stack is YAML-first and does NOT read this
# file (it mounts ../config.yaml instead). Keep this as the canonical list of
# every CHOMOSYNCER_* override, and as the config source if you *prefer* env
# over YAML: copy to deploy/chomosyncer-go.env (git-ignored), then in
# docker-compose.yml uncomment `env_file:` and drop the config.yaml mount.
#
# Config precedence (low -> high):
#   built-in DefaultConfig()  <  config.yaml  <  CHOMOSYNCER_* env  <  CLI flag.
#
# This is a CURATED SUBSET — every CLI flag has a CHOMOSYNCER_* twin (rule:
# flag "-redis-pool-size" -> env "CHOMOSYNCER_REDIS_POOL_SIZE"; full list:
# `chomosyncer-go -h`). Some params (redis dial/read/write timeouts, *.key_prefix,
# stream_maxlen, ch retry backoffs, collector reconnect/stagger timeouts, ...)
# have NO env twin and can only be set in config.yaml.

# --- Binance (real market; testnet: fstream.binancefuture.com / testnet.binancefuture.com) ---
CHOMOSYNCER_WS_URL=wss://fstream.binance.com
CHOMOSYNCER_REST_URL=https://fapi.binance.com

# --- kline intervals ---
# This build ingests ONLY 1m from the exchange; it must stay "1m".
CHOMOSYNCER_INTERVALS=1m
# Coarser intervals are derived (ClickHouse rollups + derived kline_ready).
# Must be Xs/Xm/Xh multiples of 1m, or 1d. Leave unset to use the built-in default.
CHOMOSYNCER_SERVE_INTERVALS=5m,15m,1h,4h,1d
CHOMOSYNCER_SHARDS_PER_INTERVAL=4

# --- Redis: closed-bar 200 window + kline_ready stream ---
CHOMOSYNCER_REDIS_ADDR=localhost:6379
CHOMOSYNCER_REDIS_DB=0
CHOMOSYNCER_REDIS_PASSWORD=

# --- Redis: live (unclosed) bar snapshot; blank = reuse the closed-bar endpoint ---
CHOMOSYNCER_LIVE_REDIS_ADDR=
CHOMOSYNCER_LIVE_REDIS_DB=0
CHOMOSYNCER_LIVE_REDIS_PASSWORD=
CHOMOSYNCER_LIVE_PUBLISH=false

# --- ClickHouse (native TCP; raw table market.fapi_kline_1m + rollup tables) ---
CHOMOSYNCER_CH_ADDR=localhost:9000
CHOMOSYNCER_CH_DATABASE=market
CHOMOSYNCER_CH_USERNAME=default
CHOMOSYNCER_CH_PASSWORD=

# --- dispatcher ---
CHOMOSYNCER_SECTION_TIMEOUT=5s

# --- historical gapfill / backfill (see docs/OPERATIONS.md) ---
CHOMOSYNCER_BACKFILL=true                    # cold-start + shard-reconnect backfill; false = forward-only
# Offline "load history then exit" mode. Leave false for the normal daemon;
# set true for a one-off phase-one run (docker compose run ... , see OPERATIONS.md §A.1 / §B.1).
CHOMOSYNCER_BACKFILL_OFFLINE_ONLY=false
CHOMOSYNCER_BACKFILL_START_DATE=             # e.g. 2024-01-01 ; blank = recent lookback only
CHOMOSYNCER_BACKFILL_REST_RPS=20             # token bucket for /fapi/v1/klines
CHOMOSYNCER_BACKFILL_WORKERS=4
CHOMOSYNCER_BACKFILL_GAP_DEBOUNCE=30s
CHOMOSYNCER_BACKFILL_GATE_TIMEOUT=10m
CHOMOSYNCER_BACKFILL_FLUSH_WAIT=2s

# --- observability ---
CHOMOSYNCER_METRICS_ADDR=:9090
CHOMOSYNCER_LOG_LEVEL=info
CHOMOSYNCER_LOG_FORMAT=text
