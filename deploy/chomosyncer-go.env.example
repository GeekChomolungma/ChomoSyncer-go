# Copy to chomosyncer-go.env and edit. Every flag has a CHOMOSYNCER_* twin;
# an explicit flag beats the env var.

# --- Binance (real market; testnet: fstream.binancefuture.com / testnet.binancefuture.com) ---
CHOMOSYNCER_WS_URL=wss://fstream.binance.com
CHOMOSYNCER_REST_URL=https://fapi.binance.com
CHOMOSYNCER_INTERVALS=1m,1h
CHOMOSYNCER_SHARDS_PER_INTERVAL=4

# --- Redis: closed-bar 200 window + kline_ready stream ---
CHOMOSYNCER_REDIS_ADDR=localhost:6379
CHOMOSYNCER_REDIS_DB=0
CHOMOSYNCER_REDIS_PASSWORD=

# --- Redis: live (unclosed) bar snapshot; blank = reuse the closed-bar endpoint ---
CHOMOSYNCER_LIVE_REDIS_ADDR=
CHOMOSYNCER_LIVE_REDIS_DB=0
CHOMOSYNCER_LIVE_REDIS_PASSWORD=
CHOMOSYNCER_LIVE_PUBLISH=false

# --- ClickHouse (native TCP; tables market.fapi_kline_<interval>) ---
CHOMOSYNCER_CH_ADDR=localhost:9000
CHOMOSYNCER_CH_DATABASE=market
CHOMOSYNCER_CH_USERNAME=default
CHOMOSYNCER_CH_PASSWORD=

# --- dispatcher / observability ---
CHOMOSYNCER_SECTION_TIMEOUT=5s
CHOMOSYNCER_METRICS_ADDR=:9090
CHOMOSYNCER_LOG_LEVEL=info
CHOMOSYNCER_LOG_FORMAT=text
